{
  "name": "weread",
  "version": "1.0.0",
  "description": "weread web",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "pre": "sh ./bin/preinstall.sh",
    "dev": "vite --host --force --mode dev",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr ./views/server.ts",
    "build": "sh ./bin/build.sh",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=23.10.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.42.0",
    "prettier": "^3.9.5",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@khmyznikov/pwa-install": "^0.6.4",
    "crypto-js": "^4.2.0",
    "jschardet": "^3.1.4",
    "ranui": "0.2.1-alpha.5",
    "ranuts": "0.2.0-alpha.1"
  }
